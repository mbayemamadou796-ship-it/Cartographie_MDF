# Copiez ce fichier vers .env et renseignez vos vraies valeurs.
# .env est ignoré par git — ne mettez JAMAIS de vraies clés dans .env.example.

# --- Backend API (Express + Supabase) ---
# Supabase Dashboard > Settings > API
SUPABASE_URL="https://VOTRE-PROJET.supabase.co"
SUPABASE_ANON_KEY="votre_cle_anon"
SUPABASE_SERVICE_ROLE_KEY="votre_cle_service_role"

# Port de l'API Express (Bureau: 3000, Formulaire: 3002, Rencontre: 3003)
API_PORT=3001

# CORS_ORIGIN : à définir UNIQUEMENT en production (liste des URLs autorisées,
# séparées par des virgules). En développement, laissez commenté : toutes les
# origines sont acceptées (localhost ET accès depuis un téléphone/autre PC).
# CORS_ORIGIN=https://mdf-bureau.vercel.app,https://mdf-formulaire.vercel.app,https://mdf-rencontre.vercel.app

# --- Frontend (lu par Vite, prefixe VITE_ obligatoire) ---
# VITE_API_URL : à définir UNIQUEMENT en production (URL Render de l'API).
# En développement, laissez commenté : l'application vise automatiquement le
# port 3001 de la machine qui sert la page (fonctionne aussi via QR code).
# VITE_API_URL=https://votre-api.onrender.com
